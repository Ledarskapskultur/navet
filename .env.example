# ---------------------------------------------------------------
# Navet – miljövariabler
# Kopiera till .env.local och fyll i. Lägg ALDRIG riktiga värden i git.
# Navet fungerar fullt ut utan Google. Det enda som krävs i produktion är
# en databas (Supabase) och gärna ett lösenord (APP_PASSWORD).
# ---------------------------------------------------------------

# Lösenord som skyddar hela Navet (rekommenderas när appen ligger på internet).
# Du anger det en gång per enhet och förblir sedan inloggad.
APP_PASSWORD=

# Hemlig nyckel för röst-API:t (/api/assistant) som Tasker använder när telefonen är låst.
# Generera t.ex. med:  openssl rand -base64 32
NAVET_API_TOKEN=

# Tidszon för "idag"/"imorgon" i röst-API:t (standard Europe/Stockholm)
# NAVET_TIMEZONE=Europe/Stockholm

# Webbplatser som får skicka bokningsförfrågningar till Navet (kommaseparerat).
# Tomt = alla. Exempel: https://uglsverige.store,https://ledarskapskultur.se
FORM_ALLOWED_ORIGINS=

# Visa exempeldata och en simulerad Google Tasks i stället för din egen arbetsyta.
# NAVET_DEMO=1

# Publik bas-URL (utan avslutande /). Används för OAuth redirect.
# Lokalt: http://localhost:3000   Produktion: https://navet.dindomän.se
APP_URL=http://localhost:3000

# Hemlighet för att kryptera sessionen (Google-tokens) i en httpOnly-cookie.
# Minst 32 tecken. Generera t.ex. med:  openssl rand -base64 48
SESSION_SECRET=

# Google OAuth – HELT VALFRITT. Behövs bara om du vill synka med Google Tasks.
# (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (valfritt lokalt, rekommenderat i produktion).
# Utan dessa sparas data i .navet-data/store.json.
# Service role-nyckeln används ENDAST på servern.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph / Outlook (nästa steg – används inte ännu)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Valfritt: annan katalog för den lokala filbaserade lagringen
# NAVET_DATA_DIR=
